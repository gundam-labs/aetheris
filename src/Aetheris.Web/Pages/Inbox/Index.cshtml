@page
@model Aetheris.Web.Pages.Inbox.IndexModel
@{
    ViewData["Title"] = "Inbox";
}
<h1>Inbox</h1>
<p class="lede">Results, refills, portal messages, staff tasks. Acknowledge after you have acted — this is the work queue, not a chat app.</p>
<table class="data">
    <thead><tr><th>Type</th><th>Item</th><th>Patient</th><th>For</th><th></th></tr></thead>
    <tbody>
    @foreach (var i in Model.Items)
    {
        <tr>
            <td><span class="pill">@i.Type</span></td>
            <td>
                <strong>@i.Title</strong>
                <div class="meta">@i.Body</div>
            </td>
            <td>
                @if (i.PatientId is Guid pid)
                {
                    <a href="/Chart/@pid">@i.Patient?.FullName</a>
                }
            </td>
            <td>@i.AssignedRole</td>
            <td>
                <form method="post" asp-page-handler="Done" asp-route-id="@i.Id">
                    <button class="btn secondary" type="submit">Done</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
